import socket
import csv
from datetime import datetime

# ----------- Configuration ----------- #
HOSTS_FILE = 'hosts.txt'  # List of hosts to scan
COMMON_PORTS = [22, 80, 443, 3389]  # Common ports for testing
REPORT_FILE = f'reports/security_report_{datetime.now().strftime("%Y%m%d_%H%M%S")}.csv'

# Create reports directory if it doesn't exist
import os
os.makedirs('reports', exist_ok=True)

# ----------- Functions ----------- #
def scan_port(host, port):
    """Check if a port is open on a host"""
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(1)
        result = sock.connect_ex((host, port))
        sock.close()
        return result == 0
    except Exception as e:
        print(f"Error scanning {host}:{port} -> {e}")
        return False

def generate_report(results):
    """Save scan results to CSV"""
    with open(REPORT_FILE, 'w', newline='') as csvfile:
        writer = csv.writer(csvfile)
        writer.writerow(['Host', 'Port', 'Status'])
        for host, ports in results.items():
            for port, status in ports.items():
                writer.writerow([host, port, status])
    print(f"\nReport saved to {REPORT_FILE}")

def main():
    # Read hosts from file
    try:
        with open(HOSTS_FILE, 'r') as f:
            hosts = [line.strip() for line in f if line.strip()]
    except FileNotFoundError:
        print(f"{HOSTS_FILE} not found. Please create the file and add hosts to scan.")
        return

    results = {}
    for host in hosts:
        print(f"\nScanning {host}...")
        results[host] = {}
        for port in COMMON_PORTS:
            status = 'Open' if scan_port(host, port) else 'Closed'
            results[host][port] = status
            print(f"  Port {port}: {status}")

    generate_report(results)

if __name__ == '__main__':
    main()
